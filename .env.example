# Projet Supabase → Project Settings → API.
# La clé publique suffit (publishable « sb_publishable_… » ou ancienne clé « anon ») :
# le jeu n'utilise que Realtime (présence + broadcast), aucune table.
# Sans ces deux variables, le jeu passe en mode local (onglets d'un même navigateur).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=
